---
interface NavLink {
    name: string;
    href: string;
}

const currentPath = Astro.url.pathname;

const links: NavLink[] = [
    { name: "INICIO", href: "/" },
    { name: "ECOSISTEMA", href: "/ecosystem" },
    { name: "ACADEMIAS", href: "/teams" },
    { name: "TORNEOS", href: "/tournaments" },
    { name: "SOBRE NOSOTROS", href: "/about-us" },
];

const isActive = (href: string) => {
    return href === "/"
        ? currentPath === "/"
        : currentPath.startsWith(href);
};
---

<nav>
    <div class="container">
        <div class="logo">
            <a href="/"><span>NEXTGEN</span></a>
        </div>

        <div class="nav-links">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class:list={{ active: isActive(link.href) }}
                        aria-current={
                            isActive(link.href) ? "page" : undefined
                        }
                    >
                        {link.name}
                    </a>
                ))
            }
        </div>
    </div>
</nav>

<style>
    nav{
        width: 100%;
        background-color: #131315;
        padding: 20px 0;
        position: sticky;
        top: 0;
        z-index: 1000;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        border-bottom: 1px solid rgba(255, 255, 255, 0.25);

        transition:
        padding 0.3s ease,
        background 0.3s ease,
        box-shadow 0.3s ease;
    }

    .container{
        width: 80%;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo{
        width: 30%;
    }

    .logo span{
        color: #BEC6E0;
        font-size: 32px;
        font-weight: bold;
    }

    .nav-links{
        width: 70%;
        display: flex;
        gap: 20px;
        justify-content: flex-end;
    }

    .nav-links a{
        color: white;
        text-decoration: none;
        font-size: 16px;
        font-weight: bold;
    }

    .nav-links a:hover{
        color: #BEC6E0;
    }

    .nav-links a.active {
        color: #BEC6E0;
        text-decoration: underline;
        text-underline-offset: 8px;
        text-decoration-thickness: 2px;
    }
</style>