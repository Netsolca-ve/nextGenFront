---
import MainLayout from "../layouts/MainLayout.astro";
import {
  ShieldHalf,
  GraduationCap,
  TrendingUp,
  ArrowRight,
  Volleyball,
} from "@lucide/astro";
import "./index.css";
---

<MainLayout>
  <section class="scoreboard" aria-label="Partidos">
    <ul>
      <li class="match">
        <div class="matchTop">
          <span class="mark">HOY 8:00PM</span>
        </div>

        <div class="matchBot">
          <span>TEAM 1</span>
          <strong>1 - 1</strong>
          <span>TEAM 2</span>
        </div>
      </li>

      <li class="match live">
        <div class="matchTop">
          <span class="mark liveMark">
            <span class="live-dot"></span>LIVE 65'
          </span>
        </div>

        <div class="matchBot">
          <span>TEAM 1</span>
          <strong>vs</strong>
          <span>TEAM 2</span>
        </div>
      </li>
    </ul>
  </section>

  <section class="hero" aria-labelledby="heroTitle">
    <div class="heroContent">
      <!-- <p class="season">TEMPORADA 2026</p> -->

      <h1 id="heroTitle">
        IMPULSANDO EL TALENTO DEL <span>FUTURO</span>
      </h1>

      <div class="nextMatch">
        <div class="matchInfo">
          <span>PRÓXIMO EVENTO</span>

          <div class="teams">
            <!-- <strong>TITANES</strong>
          <span>VS</span>
          <strong>RAYOS</strong> -->
            <strong>FUTSAL PROMISES LEAGUE</strong>
          </div>
        </div>

        <div class="separator"></div>

        <div class="countdown">
          <div class="time">
            <strong>02</strong>
            <span>DÍAS</span>
          </div>

          <div class="time">
            <strong>14</strong>
            <span>HRS</span>
          </div>

          <div class="time">
            <strong>35</strong>
            <span>MIN</span>
          </div>
        </div>
      </div>

      <div class="hero-actions">
        <a href="/tickets" class="primary-button">IR A TORNEOS</a>
        <a href="/calendar" class="secondary-button">VER CALENDARIO</a>
      </div>
    </div>
  </section>

  <section class="ecosystem" id="ecosystem">
    <div class="ecosystemInfo">
      <h2>EL ECOSISTEMA <span>NEXTGEN</span></h2>
      <p>
        Nuestra plataforma integral centraliza todos los servicios que un atleta
        necesita en un solo lugar.
      </p>
    </div>

    <div class="ecosystemCards">
      <article class="ecosystemCard">
        <Volleyball size={48} color="#0094DD" />
        <h3>Gestión Deportiva</h3>
        <p>Asesoramos y automatizamos semillarios deportivos.</p>
      </article>
      <article class="ecosystemCard">
        <TrendingUp size={48} color="#0094DD" />
        <h3>Desarrollo y Cuidado</h3>
        <p>Servicios especializados para deportistas de todo nivel.</p>
      </article>
      <article class="ecosystemCard">
        <ShieldHalf size={48} color="#0094DD" />
        <h3>Elite Squad</h3>
        <p>Viaja con nosotros y vive experiencias internacionales.</p>
      </article>
      <article class="ecosystemCard">
        <GraduationCap size={48} color="#0094DD" />
        <h3>Academy Lab</h3>
        <p>Formación especializada para profesionales del deporte.</p>
      </article>
    </div>
  </section>

  <!-- <section class="">

  </section> -->

  <section class="academies" id="academies">
    <div class="academiesTitle">
      <h2>ACADEMIAS DE <span>FORMACIÓN</span></h2>
      <p>
        Desarrollamos habilidades fundamentales en jóvenes atletas bajo la
        metodología NextGen.
      </p>
    </div>

